# heap - a priority queue (min-heap) for Ecko, as an immutable skew heap.
#
# A heap is a map `{ root, count, seq, family }`: `root` is null (empty) or a
# node `{ p, v, s, l, r }`, where `s` is the insertion number that breaks ties,
# so equal priorities come out first in, first out. Every operation returns a
# new heap; nothing is mutated. Merge is an explicit loop rather than recursion,
# so no heap shape can reach the recursion limit. Pure Ecko; no capabilities.
# (Exports `push`/`pop`, which shadow the list builtins; `core.push` reaches
# the builtin here.)

# Which priorities can share a heap: ints and floats order together, decimals
# and strings only among themselves.
fn family(p) = match type_of(p) {
    "int" => "number"
    "float" => "number"
    "decimal" => "decimal"
    "string" => "string"
    _ => null
}

fn is_heap(h) = type_of(h) == "map" and
    get(h, "count") != null and
    "root" in h and
    "seq" in h and
    "family" in h

fn check_heap(fname, h) {
    unless is_heap(h) {
        error(
            {
                kind: "bug",
                reason: "not_a_heap",
                message: "heap.{fname}: expected a heap from heap.new(), got {type_of(h)}",
            },
        )
    }
}

# True when node `a` comes out before node `b`.
fn before(a, b) = a.p < b.p or a.p == b.p and a.s < b.s

# Meld two skew heaps. Walks the right spines, keeping the smaller root each
# step, then rebuilds bottom-up, swapping children (the skew-heap balancing).
fn meld(a, b) {
    mut path = []
    mut x = a
    mut y = b
    while x != null and y != null {
        if before(y, x) {
            t = x
            x = y
            y = t
        }
        path = core.push(path, x)
        x = x.r
    }
    mut acc = x ?? y
    mut i = len(path) - 1
    while i >= 0 {
        n = path[i]
        acc = { p: n.p, v: n.v, s: n.s, l: acc, r: n.l }
        i -= 1
    }
    acc
}

## Returns an empty heap. Heaps are values: every operation returns a new heap
## rather than changing the one it was given.
##
## example:
##   h = heap.push(heap.new(), 1, "first")
export fn new() = { root: null, count: 0, seq: 0, family: null }

## Returns true when the heap holds no items.
##
## errors: `bug`/`not_a_heap` when `h` is not a heap.
export fn is_empty(h) {
    check_heap("is_empty", h)
    h.count == 0
}

## Returns the number of items in the heap. O(1).
##
## errors: `bug`/`not_a_heap` when `h` is not a heap.
export fn size(h) {
    check_heap("size", h)
    h.count
}

## Returns a new heap with `value` added at `priority`.
##
## Priorities are Ints and Floats (which mix), Decimals, or Strings; one heap
## holds one of those families. Items with equal priority come out in the
## order they were pushed. O(log n) amortized.
##
## errors: `bug`/`not_a_heap` when `h` is not a heap; `bug`/`bad_priority` when
## `priority` is not a number, decimal or string, or cannot be ordered against
## the priorities already in the heap.
##
## example:
##   h = heap.push(heap.new(), 5, "task")
export fn push(h, priority, value) {
    check_heap("push", h)
    fam = family(priority)
    if fam == null {
        error(
            {
                kind: "bug",
                reason: "bad_priority",
                message: "heap.push: priority must be an int, float, decimal or string, got {type_of(priority)}",
            },
        )
    }
    if h.family != null and h.family != fam {
        error(
            {
                kind: "bug",
                reason: "bad_priority",
                message: "heap.push: a {type_of(priority)} priority cannot be ordered against this heap's {h.family} priorities",
            },
        )
    }
    node = { p: priority, v: value, s: h.seq, l: null, r: null }
    { root: meld(h.root, node), count: h.count + 1, seq: h.seq + 1, family: fam }
}

## Returns `[priority, value]` of the smallest item, or null when the heap is
## empty. The heap is unchanged.
##
## errors: `bug`/`not_a_heap` when `h` is not a heap.
export fn peek(h) {
    check_heap("peek", h)
    if h.root == null { null } else { [h.root.p, h.root.v] }
}

## Removes the smallest item; returns `[[priority, value], new_heap]`.
##
## errors: `heap`/`empty` when the heap is empty; `bug`/`not_a_heap` when `h`
## is not a heap.
##
## example:
##   let (item, rest) = heap.pop(h)
export fn pop(h) {
    check_heap("pop", h)
    if h.root == null {
        error({ kind: "heap", reason: "empty", message: "heap.pop: the heap is empty" })
    }
    root = h.root
    rest = {
        root: meld(root.l, root.r),
        count: h.count - 1,
        seq: h.seq,
        family: if h.count == 1 { null } else { h.family },
    }
    [[root.p, root.v], rest]
}

## Returns a heap built from a list of `[priority, value]` pairs.
##
## errors: `bug`/`bad_argument` when `pairs` is not a list of two-element
## lists; `bug`/`bad_priority` as for `push`.
##
## example:
##   h = heap.from_list([[3, "c"], [1, "a"]])
export fn from_list(pairs) {
    unless is_list(pairs) {
        error(
            {
                kind: "bug",
                reason: "bad_argument",
                message: "heap.from_list: pairs must be a list of [priority, value] pairs, got {type_of(pairs)}",
            },
        )
    }
    mut h = new()
    for pair in pairs {
        unless is_list(pair) and len(pair) == 2 {
            error(
                {
                    kind: "bug",
                    reason: "bad_argument",
                    message: "heap.from_list: each pair must be [priority, value], got {pair}",
                },
            )
        }
        h = push(h, pair[0], pair[1])
    }
    h
}

## Returns the `k` smallest values of a plain list, ascending. A `k` larger
## than the list returns the whole list sorted.
##
## errors: `bug`/`bad_argument` when `items` is not a list, `k` is not a
## non-negative Int, or the items cannot be ordered against each other (maps,
## or a mix such as ints and strings).
##
## example:
##   heap.top_k([5, 1, 4, 2], 2)   # [1, 2]
export fn top_k(items, k) {
    unless is_list(items) {
        error(
            {
                kind: "bug",
                reason: "bad_argument",
                message: "heap.top_k: items must be a list, got {type_of(items)}",
            },
        )
    }
    unless type_of(k) == "int" and k >= 0 {
        error(
            {
                kind: "bug",
                reason: "bad_argument",
                message: "heap.top_k: k must be a non-negative int, got {k}",
            },
        )
    }
    mut fam = null
    for x in items {
        f = family(x)
        if f == null or fam != null and f != fam {
            error(
                {
                    kind: "bug",
                    reason: "bad_argument",
                    message: "heap.top_k: items must all be numbers, all decimals or all strings, got a {type_of(x)}",
                },
            )
        }
        fam = f
    }
    take(sort(items), k)
}
